OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
REDIS_URL=redis://localhost:6379/0

MYSQL_READ_HOST=127.0.0.1
MYSQL_READ_USER=JangGGo
MYSQL_READ_PASSWORD=
MYSQL_WRITE_HOST=127.0.0.1
MYSQL_WRITE_USER=JangGGo
MYSQL_WRITE_PASSWORD=
MYSQL_DATABASE=erp_system

DOCUMENT_MCP_URL=http://localhost:8001
DATA_MCP_URL=http://localhost:8002
FAISS_PATH=data/faiss

DOCUMENT_DB_HOST=127.0.0.1
DOCUMENT_DB_USER=JangGGo
DOCUMENT_DB_PASSWORD=
DOCUMENT_DB_DATABASE=erp_system

# 임베딩 백엔드: local(기본값, API/모델 다운로드 불필요) | sbert(로컬 신경망 모델,
# 최초 1회 다운로드 필요) | openai(API 비용 발생). 셋 중 하나만 씁니다.
EMBEDDING_BACKEND=local
# local 백엔드를 쓸 때의 임베딩 벡터 차원입니다. (sbert/openai는 모델이 차원을 결정하므로 무시됨)
LOCAL_EMBEDDING_DIMENSION=384
# EMBEDDING_BACKEND=sbert일 때만 사용하는 한국어 튜닝 sentence-transformers 모델입니다.
SBERT_MODEL_NAME=jhgan/ko-sroberta-multitask

# Data MCP(purchase/sales)가 조회할 도메인별 DB 이름입니다. (읽기/쓰기 계정·호스트는 MYSQL_READ_*/MYSQL_WRITE_*를 재사용)
PURCHASE_DB_DATABASE=purchase
SALES_DB_DATABASE=sales
